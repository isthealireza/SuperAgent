# Router
HOST=127.0.0.1
PORT=3088
WEBHOOK_SECRET=replace-with-a-long-random-secret
ALLOWED_SENDERS=isthealireza
TRIGGER_MENTION=@superagent
REPO_PATH=/home/alpha/src/SuperAgent
WORKTREES_DIR=/home/alpha/.local/share/dsh-superagent/worktrees
STATE_DIR=/home/alpha/.local/share/dsh-superagent/state
ARTIFACTS_DIR=/home/alpha/.local/share/dsh-superagent/artifacts
SESSION_STATE_DIR=/home/alpha/.local/share/dsh-superagent/sessions
REPOSITORIES_DIR=/home/alpha/.local/share/dsh-superagent/repositories
MAX_QUEUE=20
MAX_PER_SENDER_PER_MINUTE=3

# Triage: deepseek-compatible OpenAI chat completions API
TRIAGE_BASE_URL=https://api.deepseek.com
TRIAGE_MODEL=deepseek-flash
TRIAGE_API_KEY=

# Worker execution: claude | dsh | fixture
WORKER_ENGINE=dsh
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
DEEPSEEK_UPSTREAM_URL=https://api.deepseek.com
DSH_MODEL=deepseek-flash
WORKER_NETWORK=egress
WORKER_TEST_COMMAND=npm test
WORKER_CPUS=2
WORKER_MEMORY=2g
WORKER_PIDS=256
WORKER_TIMEOUT_SECONDS=1800
WORKER_MAX_TURNS=30

# Optional: router-only GitHub access to create a PR after a successful worker run.
# The worker never receives this token. Leave empty to produce a local patch artifact.
GITHUB_TOKEN=
GITHUB_OWNER=isthealireza
GITHUB_REPO=SuperAgent
CREATE_PULL_REQUEST=true
# Request GitHub auto-merge only after isolated worker validation succeeds.
# GitHub merges only when repository rules and required checks permit it.
AUTO_MERGE=true
PUBLIC_WEBHOOK_URL=https://your-stable-hostname.example/github/webhook
# Cloudflare Named Tunnel token; leave empty until a tunnel and hostname exist.
CLOUDFLARED_TUNNEL_TOKEN=
